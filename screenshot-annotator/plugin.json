{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "screenshot-annotator",
  "version": "0.7.4",
  "description": "Capture, annotate and paste screenshots into the current Codex composer on macOS.",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "截图标注",
        "shortDescription": "截图、画框、箭头、文字，点击对勾附图到当前聊天。",
        "developerName": "Local Tools",
        "category": "Productivity",
        "capabilities": ["Interactive", "Write"],
        "defaultPrompt": ["开始截图标注"]
      }
    }
  }
}
